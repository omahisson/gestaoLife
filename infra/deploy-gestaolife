#!/bin/sh

set -eu

ORIGEM="/var/lib/jenkins/workspace/gestao-life"
DESTINO_WEB="/var/www/gestaolife/current"
RAIZ_API="/opt/gestaolife"
RELEASES="$RAIZ_API/releases"
ATUAL="$RAIZ_API/current"
DIRETORIO_BANCO="/var/lib/gestaolife"
VERSAO="${1:-manual}"
CONFIG_NGINX_ORIGEM="$ORIGEM/infra/nginx-gestaolife.conf"
CONFIG_NGINX_DESTINO="/etc/nginx/sites-available/gestaolife"
SCRIPT_DEPLOY_NOVO="/usr/local/sbin/deploy-gestaolife.novo"

case "$VERSAO" in
  *[!A-Za-z0-9._-]*) echo "Identificador de versão inválido." >&2; exit 1 ;;
esac

RELEASE="$RELEASES/$VERSAO"

validar_arquivo() {
  if [ ! -f "$1" ]; then
    echo "Arquivo obrigatório não encontrado: $1" >&2
    exit 1
  fi
}

validar_arquivo "$ORIGEM/dist/index.html"
validar_arquivo "$ORIGEM/dist-admin/index.html"
validar_arquivo "$ORIGEM/build/servidor/principal.js"
validar_arquivo "$ORIGEM/package.json"
validar_arquivo "$ORIGEM/package-lock.json"
validar_arquivo "$CONFIG_NGINX_ORIGEM"

NODE="/usr/bin/node"
NPM="/usr/bin/npm"
if [ ! -x "$NODE" ]; then NODE="/usr/local/bin/node"; fi
if [ ! -x "$NPM" ]; then NPM="/usr/local/bin/npm"; fi
if [ ! -x "$NODE" ] || [ ! -x "$NPM" ]; then
  echo "Node.js e npm não foram encontrados." >&2
  exit 1
fi

/usr/bin/install -d -o www-data -g www-data -m 0755 "$DESTINO_WEB"
/usr/bin/install -d -o gestaolife -g gestaolife -m 0750 "$RELEASES" "$DIRETORIO_BANCO"

if [ -e "$RELEASE" ]; then
  echo "A versão $VERSAO já existe." >&2
  exit 1
fi

/usr/bin/install -d -o gestaolife -g gestaolife -m 0750 "$RELEASE"
/usr/bin/rsync -a --chown=gestaolife:gestaolife "$ORIGEM/build/" "$RELEASE/build/"
/usr/bin/rsync -a --chown=gestaolife:gestaolife "$ORIGEM/dist-admin/" "$RELEASE/dist-admin/"
/usr/bin/install -o gestaolife -g gestaolife -m 0640 "$ORIGEM/package.json" "$RELEASE/package.json"
/usr/bin/install -o gestaolife -g gestaolife -m 0640 "$ORIGEM/package-lock.json" "$RELEASE/package-lock.json"

/usr/sbin/runuser -u gestaolife -- "$NPM" --prefix "$RELEASE" ci --omit=dev --no-audit --no-fund

CONFIG_NGINX_ANTERIOR=$(/usr/bin/mktemp /etc/nginx/sites-available/gestaolife.anterior.XXXXXX)
/usr/bin/cp --preserve=mode,ownership "$CONFIG_NGINX_DESTINO" "$CONFIG_NGINX_ANTERIOR"
/usr/bin/install -o root -g root -m 0644 "$CONFIG_NGINX_ORIGEM" "$CONFIG_NGINX_DESTINO"
if ! /usr/sbin/nginx -t; then
  /usr/bin/install -o root -g root -m 0644 "$CONFIG_NGINX_ANTERIOR" "$CONFIG_NGINX_DESTINO"
  /usr/bin/rm -f "$CONFIG_NGINX_ANTERIOR"
  /usr/sbin/nginx -t
  echo "A configuração nova do Nginx foi rejeitada e a anterior foi restaurada." >&2
  exit 1
fi
/usr/bin/rm -f "$CONFIG_NGINX_ANTERIOR"

ANTERIOR=""
if [ -L "$ATUAL" ]; then ANTERIOR=$(/usr/bin/readlink -f "$ATUAL"); fi
/usr/bin/ln -sfn "$RELEASE" "$RAIZ_API/current.novo"
/usr/bin/mv -Tf "$RAIZ_API/current.novo" "$ATUAL"

/usr/bin/rsync -a --delete --chown=www-data:www-data "$ORIGEM/dist/" "$DESTINO_WEB/"
/usr/bin/systemctl restart gestaolife-api

TENTATIVA=1
while ! /usr/bin/curl -fsS "http://127.0.0.1:3001/api/saude" > /dev/null; do
  if [ "$TENTATIVA" -ge 10 ]; then
    echo "A API não respondeu após 10 tentativas." >&2
    /usr/bin/journalctl -u gestaolife-api -n 30 --no-pager >&2
    if [ -n "$ANTERIOR" ] && [ -d "$ANTERIOR" ]; then
      /usr/bin/ln -sfn "$ANTERIOR" "$RAIZ_API/current.anterior"
      /usr/bin/mv -Tf "$RAIZ_API/current.anterior" "$ATUAL"
      /usr/bin/systemctl restart gestaolife-api
      echo "A versão anterior da API foi restaurada." >&2
    fi
    exit 1
  fi
  TENTATIVA=$((TENTATIVA + 1))
  /usr/bin/sleep 1
done

/usr/bin/systemctl reload nginx
# Atualiza o próprio comando somente após uma implantação bem-sucedida.
/usr/bin/install -o root -g root -m 0755 "$ORIGEM/infra/deploy-gestaolife" "$SCRIPT_DEPLOY_NOVO"
/usr/bin/mv -Tf "$SCRIPT_DEPLOY_NOVO" /usr/local/sbin/deploy-gestaolife

echo "Gestão Life V1 implantado na versão $VERSAO."
