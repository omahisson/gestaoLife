#!/bin/sh

set -eu

ORIGEM="/var/lib/jenkins/workspace/gestao-life"
DESTINO_WEB="/var/www/gestaolife/current"
DESTINO_API="/opt/gestaolife"
DESTINO_PUBLICO_API="$DESTINO_API/public"
DIRETORIO_BANCO="/var/lib/gestaolife"
ARQUIVO_BANCO="$DIRETORIO_BANCO/db.json"
PNPM="/usr/local/bin/pnpm"

validar_arquivo() {
    if [ ! -f "$1" ]; then
        echo "Arquivo obrigatório não encontrado: $1" >&2
        exit 1
    fi
}

validar_arquivo "$ORIGEM/dist/index.html"
validar_arquivo "$ORIGEM/package.json"
validar_arquivo "$ORIGEM/pnpm-lock.yaml"
validar_arquivo "$ORIGEM/db.json"

if [ ! -x "$PNPM" ]; then
    echo "pnpm não encontrado em $PNPM" >&2
    exit 1
fi

/usr/bin/install -d -o www-data -g www-data -m 0755 "$DESTINO_WEB"
/usr/bin/install -d -o gestaolife -g gestaolife -m 0750 "$DESTINO_API"
/usr/bin/install -d -o gestaolife -g gestaolife -m 0750 "$DESTINO_PUBLICO_API"
/usr/bin/install -d -o gestaolife -g gestaolife -m 0750 "$DIRETORIO_BANCO"

if [ ! -f "$ARQUIVO_BANCO" ]; then
    /usr/bin/install -o gestaolife -g gestaolife -m 0600 "$ORIGEM/db.json" "$ARQUIVO_BANCO"
    echo "Banco inicial criado em $ARQUIVO_BANCO."
fi

ATUALIZAR_DEPENDENCIAS=0

if ! /usr/bin/cmp -s "$ORIGEM/package.json" "$DESTINO_API/package.json"; then
    ATUALIZAR_DEPENDENCIAS=1
fi

if ! /usr/bin/cmp -s "$ORIGEM/pnpm-lock.yaml" "$DESTINO_API/pnpm-lock.yaml"; then
    ATUALIZAR_DEPENDENCIAS=1
fi

/usr/bin/install -o gestaolife -g gestaolife -m 0644 "$ORIGEM/package.json" "$DESTINO_API/package.json"
/usr/bin/install -o gestaolife -g gestaolife -m 0644 "$ORIGEM/pnpm-lock.yaml" "$DESTINO_API/pnpm-lock.yaml"

if [ "$ATUALIZAR_DEPENDENCIAS" -eq 1 ] || [ ! -x "$DESTINO_API/node_modules/.bin/json-server" ]; then
    /usr/sbin/runuser -u gestaolife -- "$PNPM" --dir "$DESTINO_API" install --prod --frozen-lockfile --ignore-scripts
fi

/usr/bin/rsync -a --delete --chown=www-data:www-data "$ORIGEM/dist/" "$DESTINO_WEB/"

/usr/sbin/nginx -t
/usr/bin/systemctl restart gestaolife-api

TENTATIVA=1
while ! /usr/bin/curl -fsS "http://127.0.0.1:3001/usuarios" > /dev/null; do
    if [ "$TENTATIVA" -ge 10 ]; then
        echo "A API não respondeu após 10 tentativas." >&2
        /usr/bin/journalctl -u gestaolife-api -n 30 --no-pager >&2
        exit 1
    fi

    TENTATIVA=$((TENTATIVA + 1))
    /usr/bin/sleep 1
done

/usr/bin/systemctl reload nginx

echo "Gestão Life implantado. O banco persistente não foi sobrescrito."
