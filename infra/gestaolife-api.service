[Unit]
Description=API do Gestão Life
After=network.target

[Service]
Type=simple
User=gestaolife
Group=gestaolife
WorkingDirectory=/opt/gestaolife/current
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DATABASE_PATH=/var/lib/gestaolife/gestao-life.sqlite
Environment=API_PORT=3001
Environment=API_HOST=127.0.0.1
ExecStart=/usr/bin/env node /opt/gestaolife/current/build/servidor/principal.js
Restart=on-failure
RestartSec=3
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gestaolife
MemoryMax=192M

[Install]
WantedBy=multi-user.target
